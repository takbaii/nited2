function addTeacher_(d){const sh=ensure_('Teachers',teacherH_()),prefix=String(d.prefix||'').trim(),first=String(d.firstName||'').trim(),last=String(d.lastName||'').trim();if(!prefix||!first||!last)return{success:false,error:'กรุณากรอกคำนำหน้า ชื่อ และนามสกุล'};const full=[prefix,first,last].join(' '),rows=list_('Teachers',teacherH_()).data||[];if(rows.some(x=>String(x.fullName).trim()===full))return{success:false,error:'มีรายชื่อนี้อยู่แล้ว'};const id=d.id||id_();sh.appendRow([id,prefix,first,last,full,d.active===undefined||String(d.active).toLowerCase()!=='false',new Date()]);audit_(d,'add','Teachers',id);return{success:true,id,fullName:full};}
function updateTeacher_(d){const sh=ensure_('Teachers',teacherH_()),row=findRow_('Teachers',d.id);if(row<0)return{success:false,error:'ไม่พบรายชื่อครู'};const old=sh.getRange(row,1,1,7).getValues()[0],prefix=d.prefix===undefined?old[1]:String(d.prefix).trim(),first=d.firstName===undefined?old[2]:String(d.firstName).trim(),last=d.lastName===undefined?old[3]:String(d.lastName).trim(),full=[prefix,first,last].join(' '),active=d.active===undefined?old[5]:String(d.active).toLowerCase()!=='false';if(!prefix||!first||!last)return{success:false,error:'ข้อมูลชื่อไม่ครบ'};const rows=list_('Teachers',teacherH_()).data||[];if(rows.some(x=>x.id!==d.id&&String(x.fullName).trim()===full))return{success:false,error:'มีรายชื่อนี้อยู่แล้ว'};sh.getRange(row,1,1,7).setValues([[d.id,prefix,first,last,full,active,new Date()]]);audit_(d,'update','Teachers',d.id);return{success:true,id:d.id,fullName:full};}
function deleteTeacher_(d){const sh=ensure_('Teachers',teacherH_()),row=findRow_('Teachers',d.id);if(row<0)return{success:false,error:'ไม่พบรายชื่อครู'};sh.deleteRow(row);audit_(d,'delete','Teachers',d.id);return{success:true,id:d.id};}
function dashboard_(){const b=list_('Booking',bookingH_()).data||[],f=list_('Files',fileH_()).data||[],s=list_('Supervision',supervisionH_()).data||[],t=list_('Teachers',teacherH_()).data||[],u=list_('Users',userH_()).data||[];return{success:true,stats:{totalBookings:b.length,completed:b.filter(x=>x.status==='นิเทศแล้ว').length,pending:b.filter(x=>x.status==='รอดำเนินการ').length,confirmed:b.filter(x=>x.status==='ยืนยันแล้ว').length,totalFiles:f.length,pendingFiles:f.filter(x=>x.status==='รอตรวจสอบ').length,totalEvaluations:s.length,pendingEvaluations:s.filter(x=>x.status==='รอตรวจสอบ').length,totalTeachers:t.length,totalUsers:u.length}};}
function audit_(d,action,entity,id){try{const a=d&&d.authToken?auth_(d.authToken,false):null;ensure_('AuditLog',auditH_()).appendRow([new Date(),a&&a.ok?a.user.username:'',action,entity,id,JSON.stringify({id})]);}catch(_){} }
