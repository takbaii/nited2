function doGet(e){try{const p=(e&&e.parameter)||{};return output_(routeGet_(p),p.callback);}catch(err){return output_({success:false,error:err.message||String(err)},(e&&e.parameter||{}).callback);}}
function doPost(e){try{return output_(routePost_(parse_(e)),null);}catch(err){return output_({success:false,error:err.message||String(err)},null);}}
function parse_(e){if(!e)return{};if(e.postData&&e.postData.contents){try{return JSON.parse(e.postData.contents);}catch(_){} }return Object.assign({},e.parameter||{});}
