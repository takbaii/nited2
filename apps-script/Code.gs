function login_(d){const u=String(d.username||'').trim(),p=String(d.password||'');if(!u||!p)return{success:false,error:'กรุณากรอกชื่อผู้ใช้และรหัสผ่าน'};const r=list_('Users',userH_()),user=(r.data||[]).find(x=>String(x.username)===u&&String(x.password)===p);if(!user)return{success:false,error:'ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง'};if(String(user.active).toLowerCase()==='false')return{success:false,error:'บัญชีนี้ถูกปิดการใช้งาน'};const token=id_()+'-'+id_();CacheService.getScriptCache().put('auth_'+token,JSON.stringify({id:user.id,username:user.username,role:user.role,fullName:user.fullName,department:user.department}),SESSION_TTL);return{success:true,user:{id:user.id,username:user.username,role:user.role,fullName:user.fullName,department:user.department,authToken:token}};}
