function setup_(){const ss=SpreadsheetApp.openById(SPREADSHEET_ID),d=defs_(),created=[];Object.keys(d).forEach(n=>{const before=ss.getSheetByName(n);ensure_(n,d[n]);if(!before)created.push(n);});seedAdmin_();seedTeachers_();seedAreas_();return {success:true,spreadsheetId:SPREADSHEET_ID,sheets:Object.keys(d),created};}
function ensure_(name,h){const ss=SpreadsheetApp.openById(SPREADSHEET_ID);let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);if(sh.getLastRow()===0)sh.getRange(1,1,1,h.length).setValues([h]);else if(h.some((x,i)=>String(sh.getRange(1,i+1).getValue()||'')!==x))sh.getRange(1,1,1,h.length).setValues([h]);sh.setFrozenRows(1);return sh;}
