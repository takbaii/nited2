function uploadFile_(d){if(!d.fileData||!d.fileName)return{success:false,error:'ข้อมูลไฟล์ไม่ครบ'};try{const folder=DriveApp.getFolderById(DRIVE_FOLDER_ID),raw=String(d.fileData),bytes=Utilities.base64Decode(raw.replace(/^data:[^;]+;base64,/,'').split(',').pop()),blob=Utilities.newBlob(bytes,d.mimeType||'application/octet-stream',d.fileName),f=folder.createFile(blob);try{f.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);}catch(_){}return{success:true,fileId:f.getId(),fileUrl:'https://drive.google.com/file/d/'+f.getId()+'/view',fileName:f.getName()};}catch(e){return{success:false,error:e.message||String(e)};}}
function addFile_(d){const id=d.id||id_();ensure_('Files',fileH_()).appendRow([new Date(),d.teacherName||'',d.fileType||'',d.fileUrl||'',d.driveFileId||'',d.fileName||'',d.status||'รอตรวจสอบ',d.submittedBy||d.teacherName||'','','','',id]);audit_(d,'add','Files',id);return{success:true,id};}
function saveSupervision_(d){let scores=[];try{scores=Array.isArray(d.scores)?d.scores:(typeof d.scores==='string'?JSON.parse(d.scores||'[]'):[]);}catch(_){scores=[];}if(scores.length!==25||scores.some(x=>x===null||x===undefined||Number(x)<0||Number(x)>4))return{success:false,error:'ต้องประเมินให้ครบทั้ง 25 ข้อ และคะแนนต้องอยู่ระหว่าง 0-4'};const total=scores.reduce((a,b)=>a+Number(b),0),percent=total,level=quality_(percent),id=d.id||id_();let evidence={};if(d.evidenceFile&&d.evidenceFile.dataUrl){const u=uploadFile_({fileData:d.evidenceFile.dataUrl,fileName:d.evidenceFile.name,mimeType:d.evidenceFile.mimeType});if(!u.success)return u;evidence={url:u.fileUrl,id:u.fileId,name:u.fileName};}ensure_('Supervision',supervisionH_()).appendRow([new Date(),d.supervisionType||'',d.supervisorName||'',d.teacherName||'',d.subjectGroup||'',d.gradeLevel||'',d.period||'',d.teachingDate||'',d.topic||'',d.teachingTechniques||'',JSON.stringify(scores),total,percent,level,d.strengths||'',d.improvements||'',d.suggestions||'',evidence.url||'',evidence.id||'',evidence.name||'',d.status||'รอตรวจสอบ','','','',id]);audit_(d,'add','Supervision',id);return{success:true,id,totalScore:total,percent,qualityLevel:level,evidenceFile:evidence};}
