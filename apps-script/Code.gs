function health_(){const r={success:true,service:APP_NAME,version:VERSION,spreadsheetId:SPREADSHEET_ID,driveFolderId:DRIVE_FOLDER_ID,timestamp:new Date().toISOString()};try{const ss=SpreadsheetApp.openById(SPREADSHEET_ID);r.spreadsheetAccessible=true;r.spreadsheetName=ss.getName();r.sheets=setup_().sheets;}catch(e){r.spreadsheetAccessible=false;r.spreadsheetError=e.message||String(e);}try{r.driveFolderName=DriveApp.getFolderById(DRIVE_FOLDER_ID).getName();r.driveAccessible=true;}catch(e){r.driveAccessible=false;r.driveError=e.message||String(e);}return r;}
function routeGet_(p){switch(String(p.action||'health')){case'health':case'debug':return health_();case'setup':return setup_();case'getBookings':return list_('Booking',bookingH_());case'getFiles':return list_('Files',fileH_());case'getEvaluations':return list_('Supervision',supervisionH_());case'getTeachers':return list_('Teachers',teacherH_());case'getLearningAreas':return list_('LearningAreas',areaH_());case'getUsers':return getUsers_(p.authToken);case'getDashboard':return dashboard_();default:return{success:false,error:'Unknown GET action: '+p.action};}}
function routePost_(d){switch(String(d.action||'')){case'health':return health_();case'setup':return setup_();case'login':return login_(d);case'addBooking':return addBooking_(d);case'updateBookingStatus':{const a=auth_(d.authToken,true);return a.ok?update_('Booking',d.id,{status:d.status}):a.result;}case'updateBooking':return update_('Booking',d.id,d);case'deleteBooking':return del_('Booking',d.id);case'addFile':return addFile_(d);case'uploadFileToDrive':return uploadFile_(d);case'updateFileStatus':return reviewFile_(d);case'deleteFile':{const a=auth_(d.authToken,true);return a.ok?del_('Files',d.id):a.result;}case'addEvaluation':case'saveSupervisionData':return saveSupervision_(d);case'updateEvaluation':return updateSupervision_(d);case'updateSupervisionStatus':return reviewSupervision_(d);case'deleteEvaluation':{const a=auth_(d.authToken,true);return a.ok?del_('Supervision',d.id):a.result;}case'addUser':case'updateUser':case'deleteUser':case'addTeacher':case'updateTeacher':case'deleteTeacher':return adminWrite_(d);default:return{success:false,error:'Unknown POST action: '+d.action};}}
function list_(name,h){const sh=ensure_(name,h),lr=sh.getLastRow();if(lr<2)return{success:true,data:[]};const rows=sh.getRange(2,1,lr-1,h.length).getValues();return{success:true,data:rows.map(r=>obj_(h,r))};}
function obj_(h,r){const map={'Timestamp':'timestamp','Date':'date','Time':'time','Teacher Name':'teacherName','Department':'department','Period':'period','Subject Name':'subjectName','Subject Code':'subjectCode','Class Level':'classLevel','Room':'room','Status':'status','ID':'id','File Type':'fileType','File URL/Link':'fileUrl','Drive File ID':'driveFileId','File Name':'fileName','SubmittedBy':'submittedBy','ReviewedAt':'reviewedAt','ReviewedBy':'reviewedBy','ReviewComment':'reviewComment','Supervision Type':'supervisionType','Supervisor Name':'supervisorName','Subject Group':'subjectGroup','Grade Level':'gradeLevel','Teaching Date':'teachingDate','Topic':'topic','Teaching Techniques':'teachingTechniques','Scores JSON':'scoresJson','Total Score':'totalScore','Percent':'percent','Quality Level':'qualityLevel','Strengths':'strengths','Improvements':'improvements','Suggestions':'suggestions','Evidence File URL':'evidenceFileUrl','Evidence Drive File ID':'evidenceDriveFileId','Evidence File Name':'evidenceFileName','Username':'username','Password':'password','Role':'role','FullName':'fullName','Active':'active','Prefix':'prefix','FirstName':'firstName','LastName':'lastName','UpdatedAt':'updatedAt','Name':'name'};const o={};h.forEach((x,i)=>o[map[x]||x]=r[i] instanceof Date?r[i].toISOString():r[i]);if(o.scoresJson){try{o.scores=JSON.parse(o.scoresJson);}catch(_){o.scores=[];}}return o;}
