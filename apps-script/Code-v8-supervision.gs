function update_(n,id,d){const s=ensure_(n),h=H[n],row=findRow_(n,id);if(row<0)return{success:false,error:'ไม่พบรายการ'};const map={date:'Date',time:'Time',teacherName:'Teacher Name',department:'Department',period:'Period',subjectName:'Subject Name',subjectCode:'Subject Code',classLevel:'Class Level',room:'Room',status:'Status',fileType:'File Type',fileUrl:'File URL/Link',driveFileId:'Drive File ID',fileName:'File Name'};Object.keys(d).forEach(k=>{if(map[k])s.getRange(row,h.indexOf(map[k])+1).setValue(d[k])});return{success:true,id};}
function reviewFile_(d){const a=auth_(d.authToken,true);if(!a.ok)return a.result;const s=ensure_('Files'),h=H.Files,row=findRow_('Files',d.id);if(row<0)return{success:false,error:'ไม่พบไฟล์'};s.getRange(row,h.indexOf('Status')+1).setValue(d.status||'รอตรวจสอบ');s.getRange(row,h.indexOf('ReviewedAt')+1).setValue(new Date());s.getRange(row,h.indexOf('ReviewedBy')+1).setValue(a.user.fullName||a.user.username);s.getRange(row,h.indexOf('ReviewComment')+1).setValue(d.comment||'');return{success:true,id:d.id};}
function reviewSupervision_(d){const a=auth_(d.authToken,true);if(!a.ok)return a.result;const s=ensure_('Supervision'),h=H.Supervision,row=findRow_('Supervision',d.id);if(row<0)return{success:false,error:'ไม่พบผลการนิเทศ'};const status=d.status||'รอตรวจสอบ';s.getRange(row,h.indexOf('Status')+1).setValue(status);s.getRange(row,h.indexOf('ReviewedAt')+1).setValue(new Date());s.getRange(row,h.indexOf('ReviewedBy')+1).setValue(a.user.fullName||a.user.username);s.getRange(row,h.indexOf('ReviewComment')+1).setValue(d.comment||'');const ds=ensure_('SupervisionDetails'),dl=ds.getLastRow();if(dl>=2){const vals=ds.getRange(2,1,dl-1,H.SupervisionDetails.length).getValues();for(let i=0;i<vals.length;i++)if(String(vals[i][1])===String(d.id))ds.getRange(i+2,H.SupervisionDetails.indexOf('Status')+1).setValue(status);}return{success:true,id:d.id};}
function adminDelete_(d,n){const a=auth_(d.authToken,true);return a.ok?del_(n,d.id):a.result;}
function del_(n,id){const s=ensure_(n),row=findRow_(n,id);if(row<0)return{success:false,error:'ไม่พบรายการ'};s.deleteRow(row);if(n==='Supervision'){const ds=ensure_('SupervisionDetails'),lr=ds.getLastRow();if(lr>=2){const vals=ds.getRange(2,1,lr-1,H.SupervisionDetails.length).getValues();for(let i=vals.length-1;i>=0;i--)if(String(vals[i][1])===String(id))ds.deleteRow(i+2);}}return{success:true,id};}
function findRow_(n,id){const s=ensure_(n),lr=s.getLastRow();if(lr<2)return-1;const idCol=H[n].indexOf('ID');if(idCol<0)return-1;const a=s.getRange(2,idCol+1,lr-1,1).getValues();for(let i=0;i<a.length;i++)if(String(a[i][0])===String(id))return i+2;return-1;}
function adminWrite_(d){const a=auth_(d.authToken,true);if(!a.ok)return a.result;if(d.action==='addUser')return addUser_(d);if(d.action==='updateUser')return updateUser_(d);if(d.action==='deleteUser')return deleteUser_(d);if(d.action==='addTeacher')return addTeacher_(d);if(d.action==='updateTeacher')return updateTeacher_(d);return deleteTeacher_(d);}
function addUser_(d){const s=ensure_('Users'),u=String(d.username||'').trim();if(!u||!d.password)return{success:false,error:'กรุณาระบุชื่อผู้ใช้และรหัสผ่าน'};if((list_('Users').data||[]).some(x=>String(x.username).toLowerCase()===u.toLowerCase()))return{success:false,error:'ชื่อผู้ใช้นี้มีอยู่แล้ว'};const id=d.id||id_();s.appendRow([u,String(d.password),d.role==='admin'?'admin':'user',d.fullName||'',d.department||'-',d.active!==false,id]);return{success:true,id};}
function updateUser_(d){const s=ensure_('Users'),row=findRow_('Users',d.id);if(row<0)return{success:false,error:'ไม่พบผู้ใช้'};const old=s.getRange(row,1,1,7).getValues()[0],rows=list_('Users').data||[],u=d.username===undefined?old[0]:String(d.username).trim(),role=d.role===undefined?old[2]:(d.role==='admin'?'admin':'user'),active=d.active===undefined?old[5]:String(d.active).toLowerCase()!=='false';if(rows.some(x=>x.id!==d.id&&String(x.username).toLowerCase()===u.toLowerCase()))return{success:false,error:'ชื่อผู้ใช้นี้มีอยู่แล้ว'};if(String(old[2])==='admin'&&role!=='admin'&&rows.filter(x=>x.role==='admin').length<=1)return{success:false,error:'ต้องมีผู้ดูแลระบบอย่างน้อย 1 คน'};s.getRange(row,1,1,7).setValues([[u,d.password?d.password:old[1],role,d.fullName===undefined?old[3]:d.fullName,d.department===undefined?old[4]:d.department,active,d.id]]);return{success:true,id:d.id};}
function deleteUser_(d){const a=auth_(d.authToken,true);if(!a.ok)return a.result;const s=ensure_('Users'),row=findRow_('Users',d.id);if(row<0)return{success:false,error:'ไม่พบผู้ใช้'};const x=s.getRange(row,1,1,7).getValues()[0];if(String(x[6])===String(a.user.id))return{success:false,error:'ไม่สามารถลบบัญชีที่กำลังใช้งานอยู่'};if(String(x[2])==='admin'&&(list_('Users').data||[]).filter(v=>v.role==='admin').length<=1)return{success:false,error:'ต้องมีผู้ดูแลระบบอย่างน้อย 1 คน'};s.deleteRow(row);return{success:true,id:d.id};}
function addTeacher_(d){const s=ensure_('Teachers'),p=String(d.prefix||'').trim(),f=String(d.firstName||'').trim(),l=String(d.lastName||'').trim(),full=[p,f,l].join(' ');if(!p||!f||!l)return{success:false,error:'กรุณากรอกข้อมูลชื่อให้ครบ'};if((list_('Teachers').data||[]).some(x=>x.fullName===full))return{success:false,error:'มีรายชื่อนี้อยู่แล้ว'};const id=d.id||id_();s.appendRow([id,p,f,l,full,true,new Date()]);return{success:true,id};}
function updateTeacher_(d){const s=ensure_('Teachers'),row=findRow_('Teachers',d.id);if(row<0)return{success:false,error:'ไม่พบรายชื่อครู'};const old=s.getRange(row,1,1,7).getValues()[0],p=d.prefix===undefined?old[1]:d.prefix,f=d.firstName===undefined?old[2]:d.firstName,l=d.lastName===undefined?old[3]:d.lastName,full=[p,f,l].join(' ');s.getRange(row,1,1,7).setValues([[d.id,p,f,l,full,old[5],new Date()]]);return{success:true,id:d.id};}
function deleteTeacher_(d){const s=ensure_('Teachers'),row=findRow_('Teachers',d.id);if(row<0)return{success:false,error:'ไม่พบรายชื่อครู'};s.deleteRow(row);return{success:true,id:d.id};}
function audit_(d,a,e,id){try{const x=d&&d.authToken?auth_(d.authToken,false):null;ensure_('AuditLog').appendRow([new Date(),x&&x.ok?x.user.username:'',a,e,id,JSON.stringify({id})])}catch(_){} }
