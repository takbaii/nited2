function setup_(){const ss=SpreadsheetApp.openById(SPREADSHEET_ID),created=[];Object.keys(H).forEach(n=>{const old=ss.getSheetByName(n);ensure_(n);if(!old)created.push(n)});seedAdmin_();seedTeachers_();seedAreas_();return{success:true,spreadsheetId:SPREADSHEET_ID,sheets:Object.keys(H),created};}
