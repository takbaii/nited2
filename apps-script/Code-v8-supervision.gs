function health_(){const r={success:true,version:VERSION,spreadsheetId:SPREADSHEET_ID,driveFolderId:DRIVE_FOLDER_ID,timestamp:new Date().toISOString()};try{const ss=SpreadsheetApp.openById(SPREADSHEET_ID);r.spreadsheetAccessible=true;r.spreadsheetName=ss.getName();r.sheets=setup_().sheets}catch(e){r.spreadsheetAccessible=false;r.spreadsheetError=String(e.message||e)}try{r.driveFolderName=DriveApp.getFolderById(DRIVE_FOLDER_ID).getName();r.driveAccessible=true}catch(e){r.driveAccessible=false;r.driveError=String(e.message||e)}return r;}
