function saveSupervision_(d){const lock=LockService.getScriptLock();try{lock.waitLock(15000);}catch(e){return{success:false,error:'ระบบกำลังบันทึกข้อมูลอื่นอยู่ กรุณาลองใหม่อีกครั้ง'}}try{let scores=[];try{scores=Array.isArray(d.scores)?d.scores:JSON.parse(d.scores||'[]')}catch(_){scores=[]}if(!Array.isArray(scores)||scores.length!==25||scores.some(x=>x===null||x===undefined||String(x)===''||isNaN(Number(x))||Number(x)<0||Number(x)>4))return{success:false,error:'ต้องประเมินให้ครบทั้ง 25 ข้อ และคะแนนต้องอยู่ระหว่าง 0-4'};const total=scores.reduce((a,b)=>a+Number(b),0),maxScore=25*4,percent=Math.round(total/maxScore*10000)/100,level=total>=90?'ดีมาก':total>=80?'ดี':total>=70?'พอใช้':total>=60?'ควรปรับปรุง':'ไม่ผ่านเกณฑ์',id=d.id||id_();if(findRow_('Supervision',id)>0)return{success:true,id,totalScore:total,percent,qualityLevel:level,duplicate:true};const supervisor=String(d.supervisorName||'').trim(),teacher=String(d.teacherName||'').trim(),group=String(d.subjectGroup||'').trim(),date=String(d.teachingDate||'').trim();if(!supervisor||!teacher||!group||!date)return{success:false,error:'กรุณากรอกข้อมูลผู้นิเทศ ผู้รับการนิเทศ กลุ่มสาระ และวันที่สอนให้ครบ'};let ef=d.evidenceFile||null;if(typeof ef==='string'){try{ef=JSON.parse(ef)}catch(_){ef=null}}let ev={};if(ef&&ef.dataUrl){if(String(ef.dataUrl).length>7*1024*1024)return{success:false,error:'ไฟล์หลักฐานมีขนาดใหญ่เกินไป'};const u=uploadEvidence_({fileData:ef.dataUrl,fileName:ef.name,mimeType:ef.mimeType});if(!u.success)return u;ev={url:u.fileUrl,id:u.fileId,name:u.fileName}}else if(d.evidenceFileUrl){ev={url:d.evidenceFileUrl,id:d.evidenceDriveFileId||'',name:d.evidenceFileName||''}}const status=d.status||'รอตรวจสอบ';ensure_('Supervision').appendRow([new Date(),d.supervisionType||'',supervisor,teacher,group,d.gradeLevel||'',d.period||'',date,d.topic||'',d.teachingTechniques||'',JSON.stringify(scores),total,percent,level,d.strengths||'',d.improvements||'',d.suggestions||'',ev.url||'',ev.id||'',ev.name||'',status,'','','',id]);const detail=ensure_('SupervisionDetails'),now=new Date(),rows=[];let q=0;CRITERIA.forEach(g=>g[1].forEach(item=>{q++;rows.push([now,id,q,g[0],item,Number(scores[q-1]),teacher,supervisor,date,status]);}));detail.getRange(detail.getLastRow()+1,1,rows.length,H.SupervisionDetails.length).setValues(rows);audit_(d,'add','Supervision',id);return{success:true,id,totalScore:total,percent,qualityLevel:level,answeredCount:25,maxScore,evidenceFileUrl:ev.url||'',evidenceDriveFileId:ev.id||'',evidenceFileName:ev.name||''};}catch(e){return{success:false,error:'บันทึกผลการนิเทศไม่สำเร็จ: '+String(e.message||e)};}finally{try{lock.releaseLock()}catch(_){}}}
function login_(d){const u=String(d.username||'').trim(),p=String(d.password||'');if(!u||!p)return{success:false,error:'กรุณากรอกชื่อผู้ใช้และรหัสผ่าน'};const user=(list_('Users').data||[]).find(x=>String(x.username)===u&&String(x.password)===p);if(!user)return{success:false,error:'ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง'};if(String(user.active).toLowerCase()==='false')return{success:false,error:'บัญชีนี้ถูกปิดการใช้งาน'};const token=id_()+'-'+id_();CacheService.getScriptCache().put('auth_'+token,JSON.stringify({id:user.id,username:user.username,role:user.role,fullName:user.fullName,department:user.department}),21600);return{success:true,user:{id:user.id,username:user.username,role:user.role,fullName:user.fullName,department:user.department,authToken:token}};}
